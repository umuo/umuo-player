CREATE TABLE indexed_media (
 source_id TEXT NOT NULL,
 media_id TEXT NOT NULL,
 parent TEXT NOT NULL,
 fingerprint TEXT NOT NULL,
 payload TEXT NOT NULL,
 PRIMARY KEY(source_id, media_id)
);
CREATE INDEX idx_indexed_media_source_parent ON indexed_media(source_id, parent);
CREATE TABLE metadata_override (
 source_id TEXT NOT NULL,
 media_id TEXT NOT NULL,
 payload TEXT,
 PRIMARY KEY(source_id, media_id)
);
CREATE TABLE playback_position (
 source_id TEXT NOT NULL,
 media_id TEXT NOT NULL,
 milliseconds INTEGER NOT NULL,
 updated_at INTEGER NOT NULL DEFAULT 0,
 PRIMARY KEY(source_id, media_id)
);
CREATE INDEX idx_playback_position_recent ON playback_position(source_id, updated_at DESC);
CREATE TABLE scan_queue (
 source_id TEXT NOT NULL,
 directory TEXT NOT NULL,
 PRIMARY KEY(source_id, directory)
);
CREATE TABLE connections (
 source_id TEXT NOT NULL PRIMARY KEY,
 payload TEXT NOT NULL
);
CREATE TABLE connection_drafts (
 source_id TEXT NOT NULL PRIMARY KEY,
 payload TEXT NOT NULL
);
allDrafts:
SELECT * FROM connection_drafts ORDER BY source_id;
saveDraft:
INSERT OR REPLACE INTO connection_drafts VALUES (?, ?);
removeDraft:
DELETE FROM connection_drafts WHERE source_id = ?;
allConnections:
SELECT * FROM connections ORDER BY source_id;
saveConnection:
INSERT OR REPLACE INTO connections VALUES (?, ?);
removeConnection:
DELETE FROM connections WHERE source_id = ?;
clearSourceMedia:
DELETE FROM indexed_media WHERE source_id = ?;
clearSourcePositions:
DELETE FROM playback_position WHERE source_id = ?;
clearSourceOverrides:
DELETE FROM metadata_override WHERE source_id = ?;
clearSourceQueue:
DELETE FROM scan_queue WHERE source_id = ?;
allMedia:
SELECT * FROM indexed_media WHERE source_id = ? ORDER BY media_id;
byId:
SELECT * FROM indexed_media WHERE source_id = ? AND media_id = ?;
children:
SELECT * FROM indexed_media WHERE source_id = ? AND parent = ?;
upsert:
INSERT OR REPLACE INTO indexed_media VALUES (?, ?, ?, ?, ?);
removeMedia:
DELETE FROM indexed_media WHERE source_id = ? AND media_id = ?;
overrideFor:
SELECT * FROM metadata_override WHERE source_id = ? AND media_id = ?;
allOverrides:
SELECT media_id, payload FROM metadata_override WHERE source_id = ?;
setOverride:
INSERT OR REPLACE INTO metadata_override VALUES (?, ?, ?);
position:
SELECT milliseconds FROM playback_position WHERE source_id = ? AND media_id = ?;
allPositions:
SELECT media_id, milliseconds FROM playback_position WHERE source_id = ?;
savePosition:
INSERT OR REPLACE INTO playback_position(source_id, media_id, milliseconds, updated_at)
VALUES (
 ?,
 ?,
 ?,
 MAX(CAST(? AS INTEGER), COALESCE((SELECT MAX(updated_at) + 1 FROM playback_position WHERE source_id = ?), 1))
);
queue:
SELECT directory FROM scan_queue WHERE source_id = ? ORDER BY directory;
enqueue:
INSERT OR IGNORE INTO scan_queue VALUES (?, ?);
finishDirectory:
DELETE FROM scan_queue WHERE source_id = ? AND directory = ?;

recentItems:
SELECT indexed_media.payload, playback_position.milliseconds
FROM indexed_media INNER JOIN playback_position
ON indexed_media.source_id = playback_position.source_id AND indexed_media.media_id = playback_position.media_id
WHERE indexed_media.source_id = ? AND playback_position.milliseconds > 0
ORDER BY playback_position.updated_at DESC
LIMIT 12;
